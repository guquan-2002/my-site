<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="切换深浅色模式"
>
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
    <circle cx="12" cy="12" r="8.4" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M12 3.6a8.4 8.4 0 0 1 0 16.8Z" fill="currentColor" />
  </svg>
</button>

<script>
  const root = document.documentElement;

  const currentTheme = () => {
    if (root.dataset.theme === 'dark' || root.dataset.theme === 'light') {
      return root.dataset.theme;
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const syncLabel = () => {
    const toggle = document.querySelector('[data-theme-toggle]');
    toggle?.setAttribute(
      'aria-label',
      currentTheme() === 'dark' ? '切换到浅色模式' : '切换到深色模式',
    );
  };

  document.addEventListener('click', (event) => {
    const toggle = (event.target as Element | null)?.closest?.('[data-theme-toggle]');
    if (!toggle) return;

    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    // 将用户选择的主题同步到页面、缓存和图表。
    const applyTheme = () => {
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncLabel();
      window.dispatchEvent(new CustomEvent('themechange'));
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (document.startViewTransition && !reduceMotion) {
      root.dataset.themeTransition = 'true';

      const transition = document.startViewTransition(applyTheme);
      transition.finished.finally(() => {
        delete root.dataset.themeTransition;
      });
    } else {
      applyTheme();
    }
  });

  syncLabel();
  document.addEventListener('astro:page-load', syncLabel);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      color var(--motion-ui) var(--motion-easing),
      border-color var(--motion-ui) var(--motion-easing);
  }

  .theme-toggle:hover {
    color: var(--red-deep);
    border-color: var(--red);
  }

  @media (max-width: 42rem) {
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
