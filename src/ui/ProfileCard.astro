---
import type { Profile } from '../core/profile';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="profile" aria-labelledby="profile-name">
  <div class="profile__identity">
    <div class="profile__name">
      <h1
        id="profile-name"
        data-reveal
        style="--reveal-delay: 0ms">
        {profile.displayName}
      </h1>
      {profile.pronunciation && (
        <p class="profile__pronunciation" data-reveal style="--reveal-delay: 70ms">
          {profile.pronunciation}
        </p>
      )}
    </div>

    {profile.avatarPath && (
      <div
        class="profile__portrait"
        aria-hidden={!profile.avatarAlt}
        data-reveal
        style="--reveal-delay: 40ms"
      >
        <img
          src={profile.avatarPath}
          width="256"
          height="256"
          alt={profile.avatarAlt || ''}
        />
      </div>
    )}
  </div>

  {profile.description && (
    <p class="profile__description" data-reveal style="--reveal-delay: 80ms">
      {profile.description}
    </p>
  )}

  <div class="profile__contact" id="contact" aria-label="联系方式">
    {profile.email && (
      <a
        class="contact-link contact-link--primary"
        href={`mailto:${profile.email}`}
        data-reveal
        style="--reveal-delay: 120ms"
      >
        {profile.email}
      </a>
    )}
  </div>
</section>

<style>
  .profile {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 7vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  .profile__identity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 8vw, 5.5rem);
    align-items: start;
  }

  .profile__name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: baseline;
    min-width: 0;
  }

  .profile h1 {
    margin: 0;
    font-size: clamp(4rem, 13vw, 7.2rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.065em;
  }

  .profile__pronunciation {
    margin: 0;
    color: var(--red-deep);
    font-size: 0.92rem;
    letter-spacing: 0.13em;
  }

  .profile__description {
    max-width: 29rem;
    margin: 2.2rem 0 0;
    font-size: clamp(1.35rem, 3.8vw, 1.8rem);
    line-height: 1.55;
    white-space: pre-line;
  }

  .profile__contact {
    display: grid;
    margin-top: 3rem;
  }

  .profile__contact > .contact-link {
    justify-self: start;
  }

  .contact-link {
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color var(--motion-ui) var(--motion-easing);
  }

  .contact-link--primary {
    padding: 0.7rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--red) 24%, transparent);
    border-radius: 999px;
    background: var(--red-wash);
    color: var(--ink);
    line-height: 1;
    transition:
      color var(--motion-ui) var(--motion-easing),
      border-color var(--motion-ui) var(--motion-easing),
      background-color var(--motion-ui) var(--motion-easing);
  }

  .contact-link:hover {
    color: var(--red-deep);
  }

  .contact-link--primary:hover {
    border-color: color-mix(in srgb, var(--red) 55%, transparent);
    background: color-mix(in srgb, var(--red) 10%, transparent);
  }

  .profile__portrait {
    position: relative;
    z-index: 1;
    margin-top: 0.3rem;
  }

  .profile__portrait::before {
    position: absolute;
    inset: -0.4rem;
    border: 1px solid color-mix(in srgb, var(--red) 24%, transparent);
    border-radius: 50%;
    content: '';
  }

  .profile__portrait img {
    display: block;
    width: clamp(5rem, 11vw, 6.5rem);
    height: clamp(5rem, 11vw, 6.5rem);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0.6rem 1.5rem -0.6rem rgba(79, 42, 36, 0.14);
  }

  @media (max-width: 42rem) {
    .profile__identity {
      gap: 1.25rem;
      align-items: center;
    }

    .profile__portrait img {
      width: clamp(4rem, 18vw, 5rem);
      height: clamp(4rem, 18vw, 5rem);
    }

    .profile h1 {
      font-size: clamp(3.7rem, 22vw, 6rem);
    }

    .profile__contact {
      margin-top: 2.3rem;
    }

    .contact-link--primary {
      max-width: 100%;
      overflow-wrap: anywhere;
    }
  }
</style>
