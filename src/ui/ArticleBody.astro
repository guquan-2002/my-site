---
import 'katex/dist/katex.min.css';
---

<div class="prose" data-article-body data-reveal style="--reveal-delay: 260ms">
  <slot />
</div>

<script>
  let mermaidApi: (typeof import('mermaid'))['default'] | null = null;

  const setupCopyButtons = () => {
    const blocks = document.querySelectorAll<HTMLElement>(
      '[data-article-body] pre:not([data-diagram])',
    );

    blocks.forEach((block) => {
      if (block.querySelector('.copy-code')) return;

      const code = block.querySelector('code');
      if (!code) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');

      let resetTimer = 0;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          button.textContent = '已复制';
        } catch {
          button.textContent = '未复制';
        }

        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          button.textContent = '复制';
        }, 2200);
      });

      block.append(button);
    });
  };

  const renderDiagrams = async () => {
    const diagrams = Array.from(
      document.querySelectorAll<HTMLElement>('[data-article-body] [data-diagram="mermaid"]'),
    );
    if (diagrams.length === 0) return;

    if (!mermaidApi) {
      mermaidApi = (await import('mermaid')).default;
    }

    const styles = getComputedStyle(document.documentElement);
    const token = (name: string) => styles.getPropertyValue(name).trim();

    mermaidApi.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      fontFamily: '"LXGW Wenkai", KaiTi, serif',
      themeVariables: {
        background: token('--paper'),
        primaryColor: token('--red-pale'),
        primaryTextColor: token('--ink'),
        primaryBorderColor: token('--red'),
        lineColor: token('--ink-soft'),
        secondaryColor: token('--paper-muted'),
        tertiaryColor: token('--paper-bright'),
      },
    });

    diagrams.forEach((diagram) => {
      if (diagram.dataset.source === undefined) {
        diagram.dataset.source = diagram.textContent ?? '';
      } else {
        diagram.textContent = diagram.dataset.source;
      }
      diagram.removeAttribute('data-processed');
    });

    await mermaidApi.run({ nodes: diagrams });
  };

  let diagramRenderScheduled = false;
  const scheduleDiagramRender = () => {
    if (diagramRenderScheduled) return;
    diagramRenderScheduled = true;
    queueMicrotask(() => {
      diagramRenderScheduled = false;
      void renderDiagrams();
    });
  };

  const setupArticleBody = () => {
    setupCopyButtons();
    scheduleDiagramRender();
  };

  setupArticleBody();
  document.addEventListener('astro:page-load', setupArticleBody);
  window.addEventListener('themechange', () => {
    if (mermaidApi) scheduleDiagramRender();
  });
</script>

<style is:global>
  .prose {
    padding-top: 2.8rem;
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    line-height: 1.35;
    text-wrap: balance;
  }

  .prose h2 {
    margin: 3.8rem 0 1.1rem;
    font-size: 2rem;
    font-weight: 500;
  }

  .prose h3 {
    margin: 2.8rem 0 0.9rem;
    font-size: 1.45rem;
  }

  .prose p,
  .prose ul,
  .prose ol,
  .prose blockquote,
  .prose table,
  .prose pre {
    margin-block: 1.35rem;
  }

  .prose a {
    padding-bottom: 0.12em;
    background-image:
      linear-gradient(currentColor, currentColor),
      linear-gradient(
        color-mix(in srgb, var(--red) 45%, transparent),
        color-mix(in srgb, var(--red) 45%, transparent)
      );
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size:
      0% 1px,
      100% 1px;
    text-decoration: none;
    transition:
      color var(--motion-ui) var(--motion-easing),
      background-size var(--motion-ui) var(--motion-easing);
  }

  .prose a:hover {
    background-size:
      100% 1px,
      100% 1px;
  }

  .prose blockquote {
    margin-inline: 0;
    padding: 0.2rem 0 0.2rem 1.3rem;
    border-left: 0.18rem solid color-mix(in srgb, var(--red) 50%, transparent);
    color: var(--ink-soft);
  }

  .prose img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 0.4rem;
  }

  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose th,
  .prose td {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .prose :not(pre) > code {
    padding: 0.08em 0.34em;
    border-radius: 0.25rem;
    background: var(--red-faint);
    color: var(--red-deep);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose pre {
    position: relative;
    overflow-x: auto;
    padding: 1.3rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .prose pre code {
    font-family: inherit;
  }

  .prose .copy-code {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    padding: 0.35rem 0.58rem;
    border: 1px solid var(--line);
    border-radius: 0.32rem;
    background: color-mix(in srgb, var(--paper-bright) 92%, transparent);
    color: var(--ink-soft);
    cursor: pointer;
    font-family: var(--font-main);
    font-size: 0.72rem;
    line-height: 1;
    opacity: 0;
    transition:
      opacity var(--motion-ui) var(--motion-easing),
      color var(--motion-ui) var(--motion-easing),
      border-color var(--motion-ui) var(--motion-easing);
  }

  .prose .copy-code:hover {
    border-color: var(--red);
    color: var(--red-deep);
  }

  .prose pre:hover .copy-code,
  .prose .copy-code:focus-visible {
    opacity: 1;
  }

  .prose pre[data-diagram='mermaid'] {
    border-color: color-mix(in srgb, var(--red) 22%, transparent);
    background: var(--paper-bright);
    white-space: pre-wrap;
  }

  .prose pre[data-diagram='mermaid'] svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.4rem;
  }

  .prose .footnotes {
    margin-top: 4rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
