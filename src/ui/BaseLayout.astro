---
import '../styles/foundation.css';

import { ClientRouter } from 'astro:transitions';

import { getFullName, type Profile } from '../core/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: Profile;
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  profile,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site!;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL('/og.png', siteUrl);
const fullName = getFullName(profile);
const sameAs = [profile.x?.url, profile.github?.url, profile.profileUrl].filter(Boolean);
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.displayName,
  alternateName: profile.pronunciation,
  url: siteUrl.toString(),
  image: profile.avatarPath
    ? new URL(profile.avatarPath, siteUrl).toString()
    : undefined,
  description: profile.description,
  sameAs: sameAs.length > 0 ? sameAs : undefined,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@callmebill/lxgw-wenkai-web@latest/style.css"
    />
    {profile.avatarPath && <link rel="icon" href={profile.avatarPath} type="image/png" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullName} 的个人主页`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personData)} />
    <ClientRouter />
  </head>
  <body>
    <div class="page-glow" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label="返回主页">
          <span>{profile.displayName}</span>
          {profile.pronunciation && <small>{profile.pronunciation}</small>}
        </a>
        <div class="site-tools">
          <ThemeToggle />
          <nav class="site-nav" aria-label="主导航">
            <a href="/#contact">联系</a>
            <a href="/#notes">近记</a>
          </nav>
        </div>
      </div>
    </header>

    <div class="site-shell">
      <slot />

      <footer class="site-footer">
        <p data-reveal style="--reveal-delay: 1240ms">
          © {new Date().getFullYear()} {profile.displayName}
        </p>
        <nav aria-label="页尾链接">
          {profile.email && (
            <a href={`mailto:${profile.email}`} data-reveal style="--reveal-delay: 1320ms">
              邮箱
            </a>
          )}
          {profile.x?.url && (
            <a
              href={profile.x.url}
              target="_blank"
              rel="me noreferrer noopener"
              data-reveal
              style="--reveal-delay: 1400ms"
            >
              X
            </a>
          )}
          {profile.github?.url && (
            <a
              href={profile.github.url}
              target="_blank"
              rel="me noreferrer noopener"
              data-reveal
              style="--reveal-delay: 1480ms"
            >
              GitHub
            </a>
          )}
          {profile.profileUrl && (
            <a
              href={profile.profileUrl}
              target="_blank"
              rel="me noreferrer noopener"
              data-reveal
              style="--reveal-delay: 1560ms"
            >
              Gravatar
            </a>
          )}
        </nav>
      </footer>
    </div>

    <button class="back-to-top" type="button" data-back-to-top aria-label="返回顶部">
      <svg class="back-to-top__ring" viewBox="0 0 36 36" aria-hidden="true">
        <circle class="back-to-top__ring-track" cx="18" cy="18" r="16.5" />
        <circle class="back-to-top__progress" cx="18" cy="18" r="16.5" />
      </svg>
      <svg
        class="back-to-top__arrow"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
      >
        <path
          d="M12 19V5M5 12l7-7 7 7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <script>
      let revealObserver: IntersectionObserver | null = null;
      let curtainObserver: IntersectionObserver | null = null;

      const setupReveal = () => {
        revealObserver?.disconnect();
        curtainObserver?.disconnect();

        // 首屏内元素按预设的 --reveal-delay 依次出现；首屏外元素进入视口后再
        // 等 80ms 即可，避免滚动到它们时还要等很久。
        const vh = window.innerHeight;
        const reduceOffscreenDelay = (target: Element) => {
          const el = target as HTMLElement;
          const delay = Number.parseFloat(el.style.getPropertyValue('--reveal-delay')) || 0;
          if (delay > 200 && el.getBoundingClientRect().top >= vh) {
            el.style.setProperty('--reveal-delay', '80ms');
          }
        };

        document
          .querySelectorAll('[data-reveal], [data-reveal-split]')
          .forEach(reduceOffscreenDelay);

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px 0px 0px', threshold: 0.05 },
        );

        document
          .querySelectorAll(
            '[data-reveal]:not(.is-visible):not(.reveal-curtain), [data-reveal-split]:not(.is-visible)',
          )
          .forEach((target) => revealObserver?.observe(target));

        // reveal-curtain 初始会被 clip-path 完全裁掉，IntersectionObserver 会因此
        // 判定为不可见而无法触发。对这类元素改用 threshold: 0 观察，再按 isIntersecting
        // 决定是否显示，这样 clip-path 裁剪也能正确触发。
        curtainObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                curtainObserver?.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px 0px 0px', threshold: 0 },
        );

        document
          .querySelectorAll(
            '[data-reveal].reveal-curtain:not(.is-visible)',
          )
          .forEach((target) => curtainObserver?.observe(target));
      };

      setupReveal();
      document.addEventListener('astro:page-load', setupReveal);

      // ---- 全局鼠标光晕 ----
      const initPageGlow = () => {
        const root = document.documentElement;
        if (root.dataset.pageGlowBound) return;
        root.dataset.pageGlowBound = 'true';

        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

        let glowFrame = 0;
        document.addEventListener(
          'mousemove',
          (event) => {
            cancelAnimationFrame(glowFrame);
            glowFrame = requestAnimationFrame(() => {
              root.style.setProperty('--page-glow-x', `${event.clientX}px`);
              root.style.setProperty('--page-glow-y', `${event.clientY}px`);
            });
          },
          { passive: true },
        );
      };

      initPageGlow();

      // ---- 头部随滚动收缩、返回顶部进度环、导航高亮 ----
      const CHROME_CIRCUMFERENCE = 2 * Math.PI * 16.5;

      let chromeHeader: HTMLElement | null = null;
      let chromeBackToTop: HTMLButtonElement | null = null;
      let chromeRing: SVGCircleElement | null = null;
      let chromeNavLinks: HTMLAnchorElement[] = [];
      let chromeNavSections: Array<{ link: HTMLAnchorElement; section: HTMLElement }> = [];
      let chromeMaxScroll = 0;
      let chromeTicking = false;
      let chromeScrolled: boolean | null = null;
      let chromeBackVisible: boolean | null = null;
      let chromeActiveLink: HTMLAnchorElement | null = null;
      let chromeLastDashOffset = -1;
      let chromeLastNavUpdate = 0;

      const cacheChrome = () => {
        chromeHeader = document.querySelector<HTMLElement>('.site-header');
        chromeBackToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        chromeRing = document.querySelector<SVGCircleElement>('.back-to-top__progress');
        chromeNavLinks = Array.from(
          document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="/#"]'),
        );
        chromeNavSections = chromeNavLinks.flatMap((link) => {
          const id = (link.getAttribute('href') || '').split('#')[1];
          const section = id ? document.getElementById(id) : null;
          return section ? [{ link, section }] : [];
        });
        chromeMaxScroll = Math.max(
          document.documentElement.scrollHeight - document.documentElement.clientHeight,
          0,
        );
      };

      const updateChrome = () => {
        chromeTicking = false;

        const y = window.scrollY;

        const scrolled = y > 8;
        if (scrolled !== chromeScrolled) {
          chromeScrolled = scrolled;
          chromeHeader?.classList.toggle('is-scrolled', scrolled);
        }

        const backVisible = y > 480;
        if (backVisible !== chromeBackVisible) {
          chromeBackVisible = backVisible;
          chromeBackToTop?.classList.toggle('is-visible', backVisible);
        }

        const ratio = chromeMaxScroll > 0 ? Math.min(y / chromeMaxScroll, 1) : 0;
        const dashOffset = CHROME_CIRCUMFERENCE * (1 - ratio);
        if (chromeRing && Math.abs(dashOffset - chromeLastDashOffset) > 0.5) {
          chromeLastDashOffset = dashOffset;
          chromeRing.style.strokeDashoffset = String(dashOffset);
        }

        const now = performance.now();
        if (now - chromeLastNavUpdate > 120) {
          chromeLastNavUpdate = now;
          updateNavActive();
        }
      };

      const updateNavActive = () => {
        let current: HTMLAnchorElement | null = null;
        for (let i = 0; i < chromeNavSections.length; i += 1) {
          const { link, section } = chromeNavSections[i];
          if (section.getBoundingClientRect().top <= 140) current = link;
        }
        if (current !== chromeActiveLink) {
          chromeActiveLink = current;
          for (let i = 0; i < chromeNavLinks.length; i += 1) {
            chromeNavLinks[i].classList.toggle('is-active', chromeNavLinks[i] === current);
          }
        }
      };

      const requestChromeUpdate = () => {
        if (chromeTicking) return;
        chromeTicking = true;
        window.requestAnimationFrame(updateChrome);
      };

      const initChrome = () => {
        cacheChrome();
        chromeScrolled = null;
        chromeBackVisible = null;
        chromeActiveLink = null;
        chromeLastDashOffset = -1;
        chromeLastNavUpdate = 0;
        if (chromeRing) {
          chromeRing.style.strokeDasharray = String(CHROME_CIRCUMFERENCE);
          chromeRing.style.strokeDashoffset = String(CHROME_CIRCUMFERENCE);
        }
        if (chromeBackToTop && !chromeBackToTop.dataset.chromeBound) {
          chromeBackToTop.dataset.chromeBound = 'true';
          chromeBackToTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
        updateNavActive();
        updateChrome();
      };

      initChrome();
      window.addEventListener('scroll', requestChromeUpdate, { passive: true });
      window.addEventListener('resize', requestChromeUpdate);
      document.addEventListener('astro:page-load', initChrome);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.5rem 0.8rem;
    color: var(--paper-bright);
    background: var(--ink);
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .page-glow {
    position: fixed;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      36rem 36rem at var(--page-glow-x, 50%) var(--page-glow-y, 40%),
      var(--cinnabar-glow),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .page-glow {
      opacity: 1;
    }
  }

  .site-shell {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 3rem), var(--content));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    min-height: 4.5rem;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--paper) 98%, transparent);
    box-shadow: 0 0.6rem 1.6rem -0.9rem var(--header-shadow);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 3rem), var(--content));
    min-height: 4.5rem;
    margin-inline: auto;
  }

  .site-brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: baseline;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .site-brand small {
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .site-tools {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .site-nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .site-nav a,
  .site-footer a {
    padding-bottom: 0.12rem;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0%
      1px;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-size 0.25s ease;
  }

  .site-nav a:hover,
  .site-footer a:hover {
    background-size: 100% 1px;
  }

  .site-nav a.is-active {
    color: var(--red-deep);
    background-size: 100% 1px;
  }

  .site-footer {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 7.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .site-footer p {
    margin: 0;
    font-size: 0.85rem;
  }

  .back-to-top {
    position: fixed;
    z-index: 30;
    right: max(1.4rem, env(safe-area-inset-right));
    bottom: max(1.4rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper-bright);
    color: var(--ink-soft);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .back-to-top:hover {
    color: var(--red-deep);
    border-color: var(--red);
  }

  .back-to-top__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .back-to-top__ring circle {
    fill: none;
    stroke-width: 1.4;
  }

  .back-to-top__ring-track {
    stroke: var(--line);
  }

  .back-to-top__progress {
    stroke: var(--red);
    stroke-linecap: round;
  }

  .back-to-top__arrow {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 42rem) {
    .site-shell,
    .site-header__inner {
      width: min(calc(100% - 2rem), var(--content));
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 2rem;
    }
  }
</style>
