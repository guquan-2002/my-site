---
import '../styles/foundation.css';

import { ClientRouter } from 'astro:transitions';

import { getFullName, type Profile } from '../core/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: Profile;
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  profile,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site!;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL('/og.png', siteUrl);
const fullName = getFullName(profile);
const sameAs = [profile.x?.url, profile.github?.url, profile.profileUrl].filter(Boolean);
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.displayName,
  alternateName: profile.pronunciation,
  url: siteUrl.toString(),
  image: profile.avatarPath
    ? new URL(profile.avatarPath, siteUrl).toString()
    : undefined,
  description: profile.description,
  sameAs: sameAs.length > 0 ? sameAs : undefined,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@callmebill/lxgw-wenkai-web@latest/style.css"
    />
    {profile.avatarPath && <link rel="icon" href={profile.avatarPath} type="image/png" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullName} 的个人主页`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personData)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label="返回主页">
          <span>{profile.displayName}</span>
          {profile.pronunciation && <small>{profile.pronunciation}</small>}
        </a>
        <div class="site-tools">
          <ThemeToggle />
          <nav class="site-nav" aria-label="主导航">
            <a href="/#contact">联系</a>
            <a href="/#notes">近记</a>
          </nav>
        </div>
      </div>
    </header>

    <div class="site-shell">
      <slot />

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {profile.displayName}</p>
        <nav aria-label="页尾链接">
          {profile.email && <a href={`mailto:${profile.email}`}>邮箱</a>}
          {profile.x?.url && (
            <a href={profile.x.url} target="_blank" rel="me noreferrer noopener">X</a>
          )}
          {profile.github?.url && (
            <a href={profile.github.url} target="_blank" rel="me noreferrer noopener">
              GitHub
            </a>
          )}
          {profile.profileUrl && (
            <a href={profile.profileUrl} target="_blank" rel="me noreferrer noopener">
              Gravatar
            </a>
          )}
        </nav>
      </footer>
    </div>

    <script>
      const setupReveal = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );

        document
          .querySelectorAll('[data-reveal]:not(.is-visible)')
          .forEach((target) => observer.observe(target));
      };

      setupReveal();
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.5rem 0.8rem;
    color: var(--paper-bright);
    background: var(--ink);
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-shell {
    width: min(calc(100% - 3rem), var(--content));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    min-height: 4.5rem;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
    transition: background-color 0.3s ease;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 3rem), var(--content));
    min-height: 4.5rem;
    margin-inline: auto;
  }

  .site-brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: baseline;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .site-brand small {
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .site-tools {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .site-nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .site-nav a,
  .site-footer a {
    padding-bottom: 0.12rem;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0%
      1px;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-size 0.25s ease;
  }

  .site-nav a:hover,
  .site-footer a:hover {
    background-size: 100% 1px;
  }

  .site-footer {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 7.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .site-footer p {
    margin: 0;
    font-size: 0.85rem;
  }

  @media (max-width: 42rem) {
    .site-shell,
    .site-header__inner {
      width: min(calc(100% - 2rem), var(--content));
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 2rem;
    }
  }
</style>
