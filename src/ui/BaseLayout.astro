---
import '../styles/foundation.css';

import { ClientRouter } from 'astro:transitions';

import { getFullName, type Profile } from '../core/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: Profile;
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  profile,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site!;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL('/og.png', siteUrl);
const fullName = getFullName(profile);
const sameAs = [profile.x?.url, profile.github?.url, profile.profileUrl].filter(Boolean);
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.displayName,
  alternateName: profile.pronunciation,
  url: siteUrl.toString(),
  image: profile.avatarPath
    ? new URL(profile.avatarPath, siteUrl).toString()
    : undefined,
  description: profile.description,
  sameAs: sameAs.length > 0 ? sameAs : undefined,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@callmebill/lxgw-wenkai-web@latest/style.css"
    />
    {profile.avatarPath && <link rel="icon" href={profile.avatarPath} type="image/png" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullName} 的个人主页`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personData)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label="返回主页">
          <span>{profile.displayName}</span>
          {profile.pronunciation && <small>{profile.pronunciation}</small>}
        </a>
        <div class="site-tools">
          <ThemeToggle />
          <nav class="site-nav" aria-label="主导航">
            <a href="/#contact">联系</a>
            <a href="/#notes">近记</a>
          </nav>
        </div>
      </div>
    </header>

    <div class="site-shell">
      <slot />

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {profile.displayName}</p>
        <nav aria-label="页尾链接">
          {profile.email && <a href={`mailto:${profile.email}`}>邮箱</a>}
          {profile.x?.url && (
            <a href={profile.x.url} target="_blank" rel="me noreferrer noopener">X</a>
          )}
          {profile.github?.url && (
            <a href={profile.github.url} target="_blank" rel="me noreferrer noopener">
              GitHub
            </a>
          )}
          {profile.profileUrl && (
            <a href={profile.profileUrl} target="_blank" rel="me noreferrer noopener">
              Gravatar
            </a>
          )}
        </nav>
      </footer>
    </div>

    <button class="back-to-top" type="button" data-back-to-top aria-label="返回顶部">
      <svg class="back-to-top__ring" viewBox="0 0 36 36" aria-hidden="true">
        <circle class="back-to-top__ring-track" cx="18" cy="18" r="16.5" />
        <circle class="back-to-top__progress" cx="18" cy="18" r="16.5" />
      </svg>
      <svg
        class="back-to-top__arrow"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
      >
        <path
          d="M12 19V5M5 12l7-7 7 7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <script>
      const setupReveal = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );

        document
          .querySelectorAll('[data-reveal]:not(.is-visible)')
          .forEach((target) => observer.observe(target));
      };

      setupReveal();
      document.addEventListener('astro:page-load', setupReveal);

      // ---- 头部随滚动收缩、返回顶部进度环、导航高亮 ----
      const CHROME_CIRCUMFERENCE = 2 * Math.PI * 16.5;

      let chromeTicking = false;
      const updateChrome = () => {
        chromeTicking = false;

        const header = document.querySelector<HTMLElement>('.site-header');
        const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        const ring = document.querySelector<SVGCircleElement>('.back-to-top__progress');

        const y = window.scrollY;
        header?.classList.toggle('is-scrolled', y > 8);
        backToTop?.classList.toggle('is-visible', y > 480);

        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? Math.min(y / max, 1) : 0;
        if (ring) ring.style.strokeDashoffset = String(CHROME_CIRCUMFERENCE * (1 - ratio));

        const links = document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="/#"]');
        let current: HTMLAnchorElement | null = null;
        links.forEach((link) => {
          const id = (link.getAttribute('href') || '').split('#')[1];
          const el = id ? document.getElementById(id) : null;
          if (el && el.getBoundingClientRect().top <= 140) current = link;
        });
        links.forEach((link) => link.classList.toggle('is-active', link === current));
      };

      const requestChromeUpdate = () => {
        if (chromeTicking) return;
        chromeTicking = true;
        window.requestAnimationFrame(updateChrome);
      };

      const initChrome = () => {
        const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        const ring = document.querySelector<SVGCircleElement>('.back-to-top__progress');
        if (ring) {
          ring.style.strokeDasharray = String(CHROME_CIRCUMFERENCE);
          ring.style.strokeDashoffset = String(CHROME_CIRCUMFERENCE);
        }
        backToTop?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        updateChrome();
      };

      initChrome();
      window.addEventListener('scroll', requestChromeUpdate, { passive: true });
      window.addEventListener('resize', requestChromeUpdate);
      document.addEventListener('astro:page-load', initChrome);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.5rem 0.8rem;
    color: var(--paper-bright);
    background: var(--ink);
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-shell {
    width: min(calc(100% - 3rem), var(--content));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    min-height: 4.5rem;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
    transition:
      min-height 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    min-height: 3.6rem;
    background: color-mix(in srgb, var(--paper) 93%, transparent);
    box-shadow: 0 0.6rem 1.6rem -0.9rem rgba(62, 48, 43, 0.22);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 3rem), var(--content));
    min-height: 4.5rem;
    margin-inline: auto;
    transition: min-height 0.3s ease;
  }

  .site-header.is-scrolled .site-header__inner {
    min-height: 3.6rem;
  }

  .site-brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: baseline;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .site-brand small {
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .site-tools {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .site-nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .site-nav a,
  .site-footer a {
    padding-bottom: 0.12rem;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0%
      1px;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-size 0.25s ease;
  }

  .site-nav a:hover,
  .site-footer a:hover {
    background-size: 100% 1px;
  }

  .site-nav a.is-active {
    color: var(--red-deep);
    background-size: 100% 1px;
  }

  .site-footer {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 7.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .site-footer p {
    margin: 0;
    font-size: 0.85rem;
  }

  .back-to-top {
    position: fixed;
    z-index: 30;
    right: max(1.4rem, env(safe-area-inset-right));
    bottom: max(1.4rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper-bright) 88%, transparent);
    color: var(--ink-soft);
    cursor: pointer;
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .back-to-top:hover {
    color: var(--red-deep);
    border-color: var(--red);
  }

  .back-to-top__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .back-to-top__ring circle {
    fill: none;
    stroke-width: 1.4;
  }

  .back-to-top__ring-track {
    stroke: var(--line);
  }

  .back-to-top__progress {
    stroke: var(--red);
    stroke-linecap: round;
  }

  .back-to-top__arrow {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 42rem) {
    .site-shell,
    .site-header__inner {
      width: min(calc(100% - 2rem), var(--content));
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 2rem;
    }
  }
</style>
