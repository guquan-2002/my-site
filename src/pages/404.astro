---
import { profile } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`此路不通｜${profile.displayName}`} description="页面不存在。" noindex>
  <main class="not-found" id="main-content">
    <p class="not-found__mark" aria-hidden="true">404</p>
    <h1>此路不通</h1>
    <a href="/">返回主页 <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
