---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import CodeCopyEnhancer from '../../components/CodeCopyEnhancer';
import MermaidEnhancer from '../../components/MermaidEnhancer';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/date';
import { getFullName, profile } from '../../lib/site';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const hasMermaid = note.body?.includes('```mermaid') ?? false;
const fullName = getFullName();
const title = [note.data.title, fullName].filter(Boolean).join('｜');
const description =
  note.data.summary ||
  [profile.displayName ? `${profile.displayName}的近记。` : undefined, note.data.title]
    .filter(Boolean)
    .join('');
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/notes/${note.id}/`}
  type="article"
>
  <main class="note-page" id="main-content">
    <article>
      <header class="note-header">
        <a class="back-link" href="/#notes"><span aria-hidden="true">←</span> 近记</a>
        <h1>{note.data.title}</h1>
        <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
        {note.data.summary && <p>{note.data.summary}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
    <CodeCopyEnhancer client:load />
    {hasMermaid && <MermaidEnhancer client:idle />}
  </main>
</BaseLayout>
