---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { profile } from '../../adapters/profile';
import { formatDate } from '../../core/date';
import ArticleBody from '../../ui/ArticleBody.astro';
import BaseLayout from '../../ui/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const title = `${note.data.title}｜${profile.displayName}`;
const description = note.data.summary || `${profile.displayName}的近记。${note.data.title}`;
---

<BaseLayout
  profile={profile}
  title={title}
  description={description}
  canonicalPath={`/notes/${note.id}/`}
  type="article"
>
  <main class="note-page" id="main-content">
    <div class="reading-progress" aria-hidden="true"></div>
    <article>
      <header class="note-header">
        <a class="back-link" href="/#notes" data-reveal>
          <span aria-hidden="true">←</span> 近记
        </a>
        <h1 data-reveal style="--reveal-delay: 70ms">{note.data.title}</h1>
        <time
          datetime={note.data.date.toISOString()}
          data-reveal
          style="--reveal-delay: 140ms"
        >
          {formatDate(note.data.date)}
        </time>
        {note.data.summary && (
          <p data-reveal style="--reveal-delay: 200ms">{note.data.summary}</p>
        )}
      </header>

      <ArticleBody>
        <Content />
      </ArticleBody>
    </article>
  </main>
</BaseLayout>

<script>
  const updateProgress = () => {
    const bar = document.querySelector<HTMLElement>('.reading-progress');
    if (!bar) return;

    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    bar.style.setProperty('--progress', String(max > 0 ? doc.scrollTop / max : 0));
  };

  let progressTicking = false;
  const requestProgressUpdate = () => {
    if (progressTicking) return;
    progressTicking = true;
    window.requestAnimationFrame(() => {
      updateProgress();
      progressTicking = false;
    });
  };

  window.addEventListener('scroll', requestProgressUpdate, { passive: true });
  window.addEventListener('resize', requestProgressUpdate);
  document.addEventListener('astro:page-load', updateProgress);

  updateProgress();
</script>

<style>
  .note-page {
    padding-block: clamp(4rem, 10vw, 7.5rem) 7rem;
  }

  .note-header {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .reading-progress {
    position: fixed;
    z-index: 40;
    top: 0;
    left: 0;
    width: 100%;
    height: 0.18rem;
    background: var(--red);
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    padding-bottom: 0.15rem;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0%
      1px;
    color: var(--red-deep);
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-size 0.25s ease;
  }

  .back-link:hover {
    background-size: 100% 1px;
  }

  .note-header h1 {
    max-width: 40rem;
    margin: 0 0 1.2rem;
    font-size: clamp(2.7rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.05em;
  }

  .note-header time {
    display: inline-block;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .note-header p {
    max-width: 35rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: 1.14rem;
  }
</style>
