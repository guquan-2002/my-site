---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { profile } from '../../adapters/profile';
import { formatDate } from '../../core/date';
import ArticleBody from '../../ui/ArticleBody.astro';
import BaseLayout from '../../ui/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const title = `${note.data.title}｜${profile.displayName}`;
const description = note.data.summary || `${profile.displayName}的近记。${note.data.title}`;
---

<BaseLayout
  profile={profile}
  title={title}
  description={description}
  canonicalPath={`/notes/${note.id}/`}
  type="article"
>
  <main class="note-page" id="main-content">
    <article>
      <header class="note-header">
        <a class="back-link" href="/#notes"><span aria-hidden="true">←</span> 近记</a>
        <h1>{note.data.title}</h1>
        <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
        {note.data.summary && <p>{note.data.summary}</p>}
      </header>

      <ArticleBody>
        <Content />
      </ArticleBody>
    </article>
  </main>
</BaseLayout>

<style>
  .note-page {
    padding-block: clamp(4rem, 10vw, 7.5rem) 7rem;
  }

  .note-header {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    color: var(--red-deep);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .note-header h1 {
    max-width: 40rem;
    margin: 0 0 1.2rem;
    font-size: clamp(2.7rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.05em;
  }

  .note-header time {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .note-header p {
    max-width: 35rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: 1.14rem;
  }
</style>
