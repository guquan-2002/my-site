<script>
  const nodes = Array.from(document.querySelectorAll<HTMLElement>('.prose pre.mermaid'));

  if (nodes.length > 0) {
    void (async () => {
      const { default: mermaid } = await import('mermaid');

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: '"LXGW Wenkai", KaiTi, serif',
        themeVariables: {
          background: '#f6f2e9',
          primaryColor: '#f8dedb',
          primaryTextColor: '#20211e',
          primaryBorderColor: '#a73835',
          lineColor: '#6e625c',
          secondaryColor: '#eee7dc',
          tertiaryColor: '#fbf9f4',
        },
      });

      await mermaid.run({ nodes });
    })();
  }
</script>
