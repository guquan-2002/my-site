---
import type { GravatarProfile, SocialAccount } from 'virtual:gravatar-profile';

interface Props {
  profile: GravatarProfile;
}

const { profile } = Astro.props;
const accounts = [profile.x, profile.github].filter(
  (account): account is SocialAccount => Boolean(account?.url),
);
---

<section class="profile" aria-labelledby="profile-name">
  <div class="profile__words">
    <div class="profile__identity">
      <h1 id="profile-name">{profile.displayName}</h1>
      {profile.pronunciation && (
        <p class="profile__pronunciation">{profile.pronunciation}</p>
      )}
    </div>

    {profile.description && (
      <p class="profile__description">{profile.description}</p>
    )}

    <div class="profile__contact" id="contact" aria-label="联系方式">
      {profile.email && (
        <a class="contact-link contact-link--primary" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      )}

      {(accounts.length > 0 || profile.profileUrl) && (
        <nav class="profile__links" aria-label="外部主页">
          {accounts.map((account) => (
            <a
              class="contact-link"
              href={account.url}
              rel="me noreferrer noopener"
              target="_blank"
            >
              {account.label}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))}
          {profile.profileUrl && (
            <a
              class="contact-link"
              href={profile.profileUrl}
              rel="me noreferrer noopener"
              target="_blank"
            >
              Gravatar<span aria-hidden="true"> ↗</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </div>

  {profile.avatarPath && (
    <div class="profile__portrait" aria-hidden={!profile.avatarAlt}>
      <img
        src={profile.avatarPath}
        width="256"
        height="256"
        alt={profile.avatarAlt || ''}
      />
    </div>
  )}
</section>
